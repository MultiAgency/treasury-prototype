# Retired as an executor (retirement phase 0): Proto's payout executor replaces it. The command forces
# EXECUTOR=off, which the invoice server refuses because invoices send payouts, so this image can't
# start a second executor for the payout agent. Removal follows in a later phase.
# Secrets come from the host environment, never from this image.
FROM node:24.22.0-slim

WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Legacy owner-contract consumers use the exact published SDK 0.4.0 pin.
RUN pnpm install --frozen-lockfile
COPY tsconfig.json ./
COPY src ./src

# The money lock, the ops log (.ops/) and the invoices' record (.invoices/) are written to the working
# directory: mount the executor's existing volume at /data. Preserve SQLite and its journals.
# Do not run another executor for this agent on a different host or volume.
WORKDIR /data
ENV NODE_ENV=production INVOICES_HOST=0.0.0.0 TRUST_PROXY=true
EXPOSE 8080
CMD ["/usr/bin/env", "EXECUTOR=off", "/app/node_modules/.bin/tsx", "/app/src/invoices-server.ts"]
