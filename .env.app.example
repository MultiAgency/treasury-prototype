# Treasury owner app only. Copy to a private env file outside the release context.
# APP_HOST is the app service's own host; PLATFORM_URL names the separate platform API.
APP_HOST=treasury-app.example.com
PLATFORM_URL=https://platform.example.com

# Set a deployment-specific app credential and a random session secret (at least 32 characters).
# Leave these out of source control, Docker build arguments and browser configuration.
TREASURY_APP_CREDENTIAL=
SESSION_SECRET=

# Attach this app service's own persistent volume at /data on Railway.
# For local verification, change APP_STATE to an absolute private directory on your machine.
APP_STATE=/data/app
PORT=8080
TRUST_PROXY=true
